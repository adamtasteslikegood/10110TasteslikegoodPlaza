{
  "statusLine": {
    "type": "command",
    "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/tui/statusline.py\"",
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/tui/subagent_statusline.py\""
  },
  "extraKnownMarketplaces": {
    "claude-code-skills": {
      "source": {
        "source": "github",
        "repo": "alirezarezvani/claude-skills"
      }
    }
  },
  "enabledPlugins": {
    "zero-hallucination-coder@claude-code-skills": true,
    "grill-with-docs@claude-code-skills": true,
    "code-tour@claude-code-skills": true,
    "collab-proof@claude-code-skills": true,
    "pm-skills@claude-code-skills": true,
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/check_sync.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-pr-review-nudge.sh\"",
            "if": "Bash(gh *)",
            "statusMessage": "Checking PR-review skill"
          }
        ]
      }
    ]
  }
}
